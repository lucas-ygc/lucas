<header class="page-heading"><p class="eyebrow mono">ARCHIVE / 按时间阅读</p><h1>归档<span class="accent">.</span></h1><p class="muted">沿着时间，回看每一份记录。</p></header>
<% let lastYear = ''; const entries = site.posts.filter(post => (!page.year || Number(formatDate(post.date, 'YYYY')) === Number(page.year)) && (!page.month || Number(formatDate(post.date, 'M')) === Number(page.month))); entries.forEach(function(post) { const year = formatDate(post.date, 'YYYY'); if(year !== lastYear) { lastYear = year; %><h2 class="archive-year mono"><%= year %><span class="muted"> /</span></h2><% } %><a class="archive-row" href="<%- url(post.path) %>"><time class="mono muted"><%= formatDate(post.date, 'MM.DD') %></time><span><%= post.title || post.slug.split('/').pop() %></span><span class="accent" aria-hidden="true">↗</span></a><% }) %>
