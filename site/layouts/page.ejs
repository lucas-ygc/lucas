<% const taxonomy = page.type === 'tags' || page.type === 'categories'; %>
<header class="page-heading"><p class="eyebrow mono"><%= page.type === 'tags' ? 'TOPICS / 标签索引' : page.type === 'categories' ? 'BOOKSHELF / 知识书架' : page.type === 'error' ? 'PAGE NOT FOUND' : 'ABOUT / 关于这里' %></p><h1><%= page.type === 'tags' ? '标签' : page.type === 'categories' ? '知识书架' : page.title %><span class="accent">.</span></h1></header>
<% if(taxonomy) { %><div class="taxonomy-list"><% (page.type === 'tags' ? site.tagsByCount : site.categoriesByCount).forEach(function(item) { %><a href="<%- url(item.path) %>"><span><span class="accent mono"><%= page.type === 'tags' ? '#' : '·' %></span> <%= item.name %></span><span class="muted mono"><%= item.length %> ↗</span></a><% }) %></div><% } else { %><article class="prose about-content"><%- page.content %></article><% } %>
