<% if (filterable) { %>
<div class="section-heading">
  <div class="section-title"><h2 id="articles-title">文章与笔记</h2><span class="small muted"><%= entries.length %> 篇</span></div>
  <div class="search-box"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg><label class="sr-only" for="post-search">搜索文章标题、摘要或标签</label><input id="post-search" type="search" placeholder="搜索文章" autocomplete="off"><kbd aria-hidden="true">/</kbd></div>
</div>
<div class="filters" aria-label="按分类筛选"><button class="filter active" type="button" data-category="" aria-pressed="true">全部</button><% site.categoriesByCount.forEach(function(category) { %><button class="filter" type="button" data-category="<%= category.name %>" aria-label="<%= category.name %>" aria-pressed="false"><%= config.categoryLabels?.[category.name] || category.name %></button><% }) %></div>
<% } %>
<div class="list-meta"><span><%= filterable && config.featuredPost ? '精选与最新记录' : '按发布日期排序' %></span><span data-result-count aria-live="polite"><%= entries.length %> 篇记录</span></div>
<div class="post-list" <%- filterable ? 'data-filterable' : '' %>>
<% entries.forEach(function(post) {
  const displayTitle = post.title || post.slug.split('/').pop();
  const categories = post.categories.map(c => c.name);
  const tags = post.tags.map(t => t.name);
  const summary = plainText(post.description || post.excerpt || '').replace(/\s+/g, ' ').trim();
  const featured = filterable && post.abbrlink === config.featuredPost;
%>
  <article class="post-row<%= post.cover ? ' has-cover' : '' %>" data-categories="<%= JSON.stringify(categories) %>" data-search="<%= [displayTitle, summary, ...categories, ...tags].join(' ').toLowerCase() %>">
    <div class="post-row-copy">
      <div class="post-category"><% if(featured) { %><span class="featured-label">精选</span><% } %><%= config.categoryLabels?.[categories[0]] || categories[0] || '技术笔记' %></div>
      <h3><a href="<%- url(post.path) %>"><%= displayTitle %><span class="post-arrow" aria-hidden="true">→</span></a></h3>
      <% if (post.series) { %><a class="series-badge" href="<%- url(post.series.path) %>">合集 · <%= post.series.title %></a><% } %>
      <% if(summary) { %><p class="post-summary"><%= truncate(summary, { length: 110 }) %></p><% } %>
      <div class="post-meta"><time class="mono" datetime="<%= formatDate(post.date, 'YYYY-MM-DD') %>"><%= formatDate(post.date, 'YYYY.MM.DD') %></time><% if(tags.length) { %><div class="post-tags"><% post.tags.slice(0, 2).forEach(function(tag) { %><a href="<%- url(tag.path) %>"><%= tag.name %></a><% }) %></div><% } %></div>
    </div>
    <% if(post.cover) { %><a class="post-thumbnail" href="<%- url(post.path) %>" tabindex="-1" aria-hidden="true"><img src="<%- url(post.cover) %>" alt="" width="240" height="160" loading="lazy"></a><% } %>
  </article>
<% }) %>
</div>
<% if(filterable) { %><p class="empty-state" hidden>没有找到匹配的记录，试试其他关键词或分类。</p><button class="load-more" type="button" hidden>更多文章 <span aria-hidden="true">↓</span></button><noscript><p class="muted">已展示全部文章；启用 JavaScript 后可使用搜索与筛选。</p></noscript><% } %>
