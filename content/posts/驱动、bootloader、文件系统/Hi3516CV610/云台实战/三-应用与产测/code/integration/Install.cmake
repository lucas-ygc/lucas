set(PTZ_ENABLED 0)
if(PTZ STREQUAL "Y")
    set(PTZ_ENABLED 1)
    if(NOT EXISTS "${RUNTIME_DIR}/ko/ptzmotor/tuling_ptzmotor.ko")
        message(FATAL_ERROR "Missing PTZ module: build SDK/Drivers/PtzMotor first")
    endif()
    install(DIRECTORY "${RUNTIME_DIR}/ko/ptzmotor" DESTINATION app/ko)
else()
    install(CODE "file(REMOVE_RECURSE \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/app/ko/ptzmotor\")")
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/ptz-features.conf.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/ptz-features.conf" @ONLY)
install(CODE "file(REMOVE \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/app/Bin/ptz-features.conf\")")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/generated/ptz-features.conf" DESTINATION app/Bin)
